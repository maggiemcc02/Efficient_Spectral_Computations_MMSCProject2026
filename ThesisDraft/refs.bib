@article{Heuveline,
abstract = {We develop a new approach to a posteriori error estimation for Galerkin finite element approximations of symmetric and nonsymmetric elliptic eigenvalue problems. The idea is to embed the eigenvalue approximation into the general framework of Galerkin methods for nonlinear variational equations. In this context residual-based a posteriori error representations are available with explicitly given remainder terms. The careful evaluation of these error representations for the concrete situation of an eigenvalue problem results in a posteriori error estimates for the approximations of eigenvalues as well as eigenfunctions. These suggest local error indicators that are used in the mesh refinement process.},
author = {Heuveline, V. and Rannacher, R.},
address = {New York},
copyright = {Kluwer Academic Publishers 2001},
issn = {1019-7168},
journal = {Advances in computational mathematics},
keywords = {Eigenvalues ;  Eigenvectors ;  Finite element method},
language = {eng},
number = {1-4},
pages = {107-138},
publisher = {Springer Nature B.V},
title = {A posteriori error control for finite element approximations of elliptic eigenvalue problems},
volume = {15},
year = {2001},
}

