journal = {Acta numerica},
keywords = {Eigenvalues ;  Finite element method},
language = {eng},
pages = {1-120},
publisher = {Cambridge University Press},
title = {Finite element approximation of eigenvalue problems},
volume = {19},
year = {2010},
}

